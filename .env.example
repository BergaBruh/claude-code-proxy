# Debug mode (verbose logging + litellm debug)
# DEBUG=true

# Required API Keys
ANTHROPIC_API_KEY="your-anthropic-api-key" # Needed if proxying *to* Anthropic
OPENAI_API_KEY="sk-..."
GEMINI_API_KEY="your-google-ai-studio-key"

# Optional: Provider Preference and Model Mapping
# Controls which provider (google, openai, or anthropic) is preferred for mapping haiku/sonnet.
# Defaults to openai if not set.
# Set to "anthropic" for "just an Anthropic proxy" mode (no remapping)
PREFERRED_PROVIDER="openai"
OPENAI_BASE_URL="https://api.openai.com/v1"

# Optional: Specify the exact models to map haiku/sonnet to.
# If PREFERRED_PROVIDER=google, these MUST be valid Gemini model names known to the server.
# Defaults to gemini-3.1-pro-preview, gemini-3-flash-preview and gemini-2.5-flash-lite if PREFERRED_PROVIDER=google.
# Defaults to gpt-5.3-codex, gpt-5.2 and gpt-5-mini if PREFERRED_PROVIDER=openai.
# These are IGNORED when PREFERRED_PROVIDER=anthropic (models are not remapped).
# BIG_MODEL="gpt-5.3-codex"
# MEDIUM_MODEL="gpt-5.2"
# SMALL_MODEL="gpt-5-mini"

# Example Google mapping:
# PREFERRED_PROVIDER="google"
# BIG_MODEL="gemini-3.1-pro-preview"
# MEDIUM_MODEL="gemini-3-flash-preview"
# SMALL_MODEL="gemini-2.5-flash-lite"

# Example Google with vertex AI auth via ADC:
# PREFERRED_PROVIDER="google"
# BIG_MODEL="gemini-3.1-pro-preview"
# MEDIUM_MODEL="gemini-3-flash-preview"
# SMALL_MODEL="gemini-2.5-flash-lite"

# Example Google Code Assist via OAuth (requires gemini-cli: npm i -g @google/gemini-cli):
# Run `gemini` once to authenticate — this creates ~/.gemini/oauth_creds.json
# PREFERRED_PROVIDER="google"
# USE_GEMINI_OAUTH=true
# BIG_MODEL="gemini-3.1-pro-preview"
# MEDIUM_MODEL="gemini-3-flash-preview"
# SMALL_MODEL="gemini-2.5-flash-lite"
# GEMINI_OAUTH_CREDS_PATH="~/.gemini/oauth_creds.json"  # default, optional
# OAuth client credentials are auto-extracted from gemini-cli if installed.
# If gemini-cli is not installed (e.g. Docker), set these manually:
# GEMINI_OAUTH_CLIENT_ID="..."       # from gemini-cli oauth2.js
# GEMINI_OAUTH_CLIENT_SECRET="..."   # from gemini-cli oauth2.js

# Example "just an Anthropic proxy" mode:
# PREFERRED_PROVIDER="anthropic"
# (BIG_MODEL, MEDIUM_MODEL and SMALL_MODEL are ignored in this mode)
